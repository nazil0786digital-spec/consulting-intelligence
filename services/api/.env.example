DATABASE_URL=sqlite:///./consulting_intelligence.db
# For PostgreSQL + pgvector, set DATABASE_URL to:
# postgresql+psycopg://USER:PASSWORD@localhost:5432/consulting_intelligence
# Optional in Phase 2. When present, indexed-text search uses OpenAI embeddings.
# Keep the real value only in your local .env file or a production secrets manager.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
